{
  "name": "orgaspot",
  "version": "1.0.0",
  "description": "CLI tool for organizing Spotify accounts - duplicate removal and playlist governance",
  "main": "dist/index.js",
  "bin": {
    "orgaspot": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "dev": "ts-node-dev --respawn src/index.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "spotify",
    "playlist",
    "organizer",
    "duplicate",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.0.0",
    "dotenv": "^16.0.0",
    "open": "^10.0.0",
    "spotify-web-api-node": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/spotify-web-api-node": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
