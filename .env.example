# Spotify API credentials (get from https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# OAuth callback URL — MUST end with /api/auth and be registered in Spotify Developer Dashboard
SPOTIFY_REDIRECT_URI=https://your-app.vercel.app/api/auth

# Frontend URL (where users are redirected after OAuth)
FRONTEND_URL=https://your-app.vercel.app/
